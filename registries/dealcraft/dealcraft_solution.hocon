# =============================================================
# DealCraft V2 — Solution Design Phase Network
# File: registries/dealcraft/dealcraft_solution.hocon
# Phase: 3 — Solution Design (6 agents)
#
# Tool guide:
#   read_file   — .md and .txt (context index, phase1-2 outputs)
#   ai_search   — live competitor research (competitive-intel-agent only)
#   write_file  — all .md output files (preferred for inter-agent communication)
#   list_files  — discover files in the deal repository
# =============================================================

{
    include "registries/llm_config.hocon",
    include "registries/agent_models.hocon",

    "metadata": {
        "description": "DealCraft V2 Solution Design Phase — 6 agents: Competitive Positioning, Win Theme Strategy, Solution Architecture, Architecture Diagrams, Platform Capabilities, Case Study Mapping. Each writes one .md to iter_N/phase3-solution/.",
        "tags": ["dealcraft", "bidmagic", "solution", "architecture", "cognizant", "presales"],
        "sample_queries": [
            "Please coordinate the agents for this phase. Context index path: repository/..."
        ]
    },

    "request_timeout_seconds": 600,

    "tools": [

        # ── Thin Orchestrator ─────────────────────────────────────────────────
        {
            "name": "solution-orchestrator",
            "function": {
                "description": "Coordinates the Solution Design phase. Reads _context_index.md, delegates to 6 solution design agents. Does NOT write files."
            },
            "instructions": "dealcraft/prompts/v2/orchestrator-solution-prompt.md",
            "llm_config": ${llm_config},
            "tools": [
                "competitive-intel-agent",
                "win-theme-agent",
                "solution-architecture-agent",
                "architecture-diagram-agent",
                "platform-capability-agent",
                "case-study-mapping-agent"
            ]
        },

        # ── Agent 1: Competitive Intel ────────────────────────────────────────
        # Has ai_search for live competitor research
        {
            "name": "competitive-intel-agent",
            "function": {
                "description": "Analyses the competitive landscape: likely competitors (TCS, Infosys, Accenture, Wipro, Capgemini), their strengths and weaknesses for this deal, Cognizant differentiators with provable numbers, and head-to-head positioning. Uses ai_search for current competitor intel. Writes to iter_N/phase3-solution/competitive-positioning.md",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "context_index_content": {
                            "type": "string",
                            "description": "Full content of _context_index.md."
                        }
                    },
                    "required": ["context_index_content"]
                }
            },
            "instructions": "dealcraft/prompts/v2/competitive-intel-v2.md",
            "llm_config": ${agent_models.competitive_intel},
            "tools": ["read_file", "write_file", "list_files", "ai_search"]
        },

        # ── Agent 2: Win Theme ────────────────────────────────────────────────
        {
            "name": "win-theme-agent",
            "function": {
                "description": "Develops 3-5 compelling win themes: differentiated, provable statements tied to Cognizant tools, accelerators, and partnerships. Each theme has a headline, proof point, and connection to client pain points. Writes to iter_N/phase3-solution/win-theme.md",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "context_index_content": {
                            "type": "string",
                            "description": "Full content of _context_index.md."
                        }
                    },
                    "required": ["context_index_content"]
                }
            },
            "instructions": "dealcraft/prompts/v2/win-theme-v2.md",
            "llm_config": ${agent_models.win_theme},
            "tools": ["read_file", "write_file", "list_files"]
        },

        # ── Agent 3: Solution Architecture ────────────────────────────────────
        {
            "name": "solution-architecture-agent",
            "function": {
                "description": "Designs the solution architecture: layers (presentation, business, integration, data, infrastructure), design decisions rationale, technology stack with Cognizant accelerators, delivery roadmap in phases, and AI/ML integration points. Writes to iter_N/phase3-solution/solution-architecture.md",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "context_index_content": {
                            "type": "string",
                            "description": "Full content of _context_index.md."
                        }
                    },
                    "required": ["context_index_content"]
                }
            },
            "instructions": "dealcraft/prompts/v2/solution-architecture-v2.md",
            "llm_config": ${agent_models.solution_architecture},
            "tools": ["read_file", "write_file", "list_files"]
        },

        # ── Agent 4: Architecture Diagrams ────────────────────────────────────
        {
            "name": "architecture-diagram-agent",
            "function": {
                "description": "Produces Mermaid diagram code for: solution architecture overview, data flow diagram, deployment architecture, integration topology. Uses graph TD / flowchart syntax. Writes to iter_N/phase3-solution/architecture-diagrams.md",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "context_index_content": {
                            "type": "string",
                            "description": "Full content of _context_index.md."
                        }
                    },
                    "required": ["context_index_content"]
                }
            },
            "instructions": "dealcraft/prompts/v2/architecture-diagram-v2.md",
            "llm_config": ${agent_models.architecture_diagram},
            "tools": ["read_file", "write_file", "list_files"]
        },

        # ── Agent 5: Platform Capabilities ────────────────────────────────────
        {
            "name": "platform-capability-agent",
            "function": {
                "description": "Maps Cognizant platform capabilities to this deal: Neuro IT, Flowsource, Utopia, Skygrade, and relevant tech partnerships (AWS, Azure, GCP, ServiceNow, Salesforce). Quantifies outcomes and references real accelerators. Writes to iter_N/phase3-solution/platform-capabilities.md",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "context_index_content": {
                            "type": "string",
                            "description": "Full content of _context_index.md."
                        }
                    },
                    "required": ["context_index_content"]
                }
            },
            "instructions": "dealcraft/prompts/v2/platform-capability-v2.md",
            "llm_config": ${agent_models.platform_capability},
            "tools": ["read_file", "write_file", "list_files"]
        },

        # ── Agent 6: Case Study Mapping ───────────────────────────────────────
        {
            "name": "case-study-mapping-agent",
            "function": {
                "description": "Selects and writes 3 relevant Cognizant case studies with quantified outcomes (% improvement, $ saved, time reduced). Each case study matches the client's industry, technology area, and deal context. Writes to iter_N/phase3-solution/case-studies.md",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "context_index_content": {
                            "type": "string",
                            "description": "Full content of _context_index.md."
                        }
                    },
                    "required": ["context_index_content"]
                }
            },
            "instructions": "dealcraft/prompts/v2/case-study-mapping-v2.md",
            "llm_config": ${agent_models.case_study_mapping},
            "tools": ["read_file", "write_file", "list_files"]
        },

        # ── Core file tools (common) ──────────────────────────────────────────
        {
            "name": "write_file",
            "function": {
                "description": "Write or append text to a file in the deal repository. Use for all .md output files. For outputs >15 KB split at section boundaries: first call mode='write', then mode='append'. Path must be relative to workspace root — use the EXACT path from Section 7 of _context_index.md.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "path":    { "type": "string", "description": "Relative path inside the deal repository. Use the EXACT path from Section 7 of _context_index.md." },
                        "content": { "type": "string", "description": "Text content to write. Keep chunks under 8000 chars; split at ## headings." },
                        "mode":    { "type": "string", "description": "'write' (default, creates/overwrites) or 'append' (adds to end)." },
                        "agent":   { "type": "string", "description": "Your agent name. Recorded in the audit log." }
                    },
                    "required": ["path", "content"]
                }
            },
            "class": "coded_tools.common.write_file.WriteFile"
        },
        {
            "name": "read_file",
            "function": {
                "description": "Read a .md or .txt file and return its content. Use for _context_index.md and prior phase .md outputs. NOT for PDFs, DOCX, PPTX, or XLSX.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "path":       { "type": "string",  "description": "Relative path inside the deal repository." },
                        "start_line": { "type": "int", "description": "1-based start line (optional).",
                        "default": null },
                        "end_line":   { "type": "int", "description": "1-based end line inclusive (optional).",
                        "default": null },
                        "agent":      { "type": "string",  "description": "Your agent name. Recorded in the audit log." }
                    },
                    "required": ["path"]
                }
            },
            "class": "coded_tools.common.read_file.ReadFile"
        },
        {
            "name": "list_files",
            "function": {
                "description": "List files in the input or output directory. Use 'input' (default) to discover uploaded client files; use 'output' to see files the agents have already written. Returns newline-separated relative paths.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "path":    { "type": "string", "description": "Sub-folder to list, relative to the chosen dir root. ALWAYS specify this — e.g. 'repository/5_acme/iter_1/phase3-solution/' for phase outputs. Do NOT pass 'input' or 'output' here — use the dir parameter for that." },
                        "dir":     { "type": "string", "description": "'input' (read root — prior-phase .md files, default) or 'output' (write root — current-phase generated files). Use path to narrow within the chosen root." },
                        "pattern": { "type": "string", "description": "Optional glob filter, e.g. '*.pdf' or '**/*.md'." },
                        "agent":   { "type": "string", "description": "Your agent name. Recorded in the audit log." }
                    }
                }
            },
            "class": "coded_tools.common.list_files.ListFiles"
        },

        # ── Web research ──────────────────────────────────────────────────────
        {
            "name": "ai_search",
            "function": {
                "description": "DuckDuckGo search with AI synthesis via LiteLLM proxy. Returns a focused, cited answer. Use for live competitor research, technology trends, and market intelligence. Requires LiteLLM proxy running on localhost:4000.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "query":       { "type": "string",  "description": "Search query." },
                        "purpose":     { "type": "string",  "description": "Context for AI synthesis — makes the answer more targeted." },
                        "max_results": { "type": "int", "description": "Number of results to synthesise from (default 8, max 15).",
                        "default": null },
                        "timelimit":   { "type": "string",  "description": "Time filter: 'd' (day), 'w' (week), 'm' (month)." },
                        "agent":       { "type": "string",  "description": "Your agent name. Recorded in the audit log." }
                    },
                    "required": ["query"]
                }
            },
            "class": "coded_tools.common.ai_search.AiSearch"
        }
    ]
}
